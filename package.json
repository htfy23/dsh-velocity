{
  "name": "dsh-velocity",
  "version": "1.0.5",
  "description": "Session velocity auditor for DeepSeek Harness: measures reclaimable wait time (background jobs blocked on, blind sleeps, unmergeable commands, serial subagent fan-out, timeouts), keeps a verified lesson library, and A/Bs a new conversation against an old one to report the speedup percentage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htfy23/dsh-velocity.git"
  },
  "homepage": "https://github.com/htfy23/dsh-velocity#readme",
  "bugs": {
    "url": "https://github.com/htfy23/dsh-velocity/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "velocity",
    "audit",
    "time-waste",
    "session-analysis",
    "lessons"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/",
    "assets/",
    "!assets/__pycache__/",
    "!assets/.audit_state/",
    "!assets/.query_state/",
    "!assets/lessons.jsonl",
    "!assets/lessons.jsonl.bak-*",
    "!assets/eval/batch_evidence*.json",
    "!assets/eval/batch_attribution*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-0 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
