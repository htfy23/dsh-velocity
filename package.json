{
  "name": "dsh-velocity",
  "version": "2.0.0",
  "description": "Session velocity auditor: measures reclaimable wait time (blocking waits, blind sleeps, unmergeable commands, timeouts), tracks verified lessons, and reports the speedup percentage per round.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "velocity",
    "audit",
    "time-waste",
    "session-analysis",
    "lessons"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "private": true
}
